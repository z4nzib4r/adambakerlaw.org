---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { firm, hours, payments, mapsEmbed, mapsLink } from '../data/site';
---

<Base title="Contact" description="Contact Adam Baker, Attorney at Law, at 8 N Court St, Ste. 212, Athens, OH 45701. Phone (740) 592-9043.">
  <PageHero
    eyebrow="Contact"
    title="Let's talk about your situation."
    lead="If you have questions or would like to schedule an appointment, call the office or send a message below."
  />

  <section class="section">
    <div class="container contact">
      <div class="info">
        <div class="info__block">
          <h2 class="h-small">Office</h2>
          <address>
            {firm.fullName}<br />
            {firm.address.street}, {firm.address.suite}<br />
            {firm.address.city}, {firm.address.state} {firm.address.zip}
          </address>
          <a href={mapsLink} target="_blank" rel="noopener">Get directions →</a>
        </div>

        <div class="info__block">
          <h2 class="h-small">Reach us</h2>
          <dl class="kv">
            <dt>Phone</dt>
            <dd><a href={firm.phoneHref}>{firm.phone}</a></dd>
            <dt>Fax</dt>
            <dd>{firm.fax}</dd>
            <dt>Email</dt>
            <dd><a href={`mailto:${firm.email}`}>{firm.email}</a></dd>
            <dt>Social</dt>
            <dd><a href={firm.facebook} target="_blank" rel="noopener">Facebook</a></dd>
          </dl>
        </div>

        <div class="info__block">
          <h2 class="h-small">Business hours</h2>
          <dl class="kv">
            {
              hours.map((h) => (
                <>
                  <dt>{h.day}</dt>
                  <dd>{h.time}</dd>
                </>
              ))
            }
          </dl>
          <p class="note">Evening and weekend appointments may be available upon request.</p>
        </div>

        <div class="info__block">
          <h2 class="h-small">Accepted payment</h2>
          <ul class="pills">
            {payments.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>

      <div class="card form-card">
        <h2>Send a message</h2>
        <p class="muted">Use this form to send requests, inquiries, or to ask for an appointment.</p>
        <form id="contact-form" novalidate>
          <div class="row">
            <label>
              <span>Name *</span>
              <input name="name" type="text" autocomplete="name" required />
            </label>
            <label>
              <span>Phone</span>
              <input name="phone" type="tel" autocomplete="tel" />
            </label>
          </div>
          <label>
            <span>Email *</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label>
            <span>How can we help? *</span>
            <textarea name="message" rows="6" required></textarea>
          </label>
          <label class="consent">
            <input name="consent" type="checkbox" required />
            <span>
              I understand that submitting this form does not create an attorney–client relationship, and I agree
              that my information may be used to contact me.
            </span>
          </label>
          <p class="error" role="alert" hidden>Please fill in your name, a valid email, your message, and check the box above.</p>
          <button class="btn btn--primary" type="submit">Send message</button>
          <p class="fine">
            Please don't include confidential details here. For urgent matters, call
            <a href={firm.phoneHref}>{firm.phone}</a>.
          </p>
        </form>
      </div>
    </div>
  </section>

  <section id="location" class="map-section" aria-label="Office location">
    <iframe
      title="Map showing the office at 8 N Court St, Athens, OH"
      src={mapsEmbed}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
    <div class="map-card card">
      <span class="eyebrow">Location</span>
      <h2>Downtown Athens</h2>
      <p>
        On Court Street in the heart of uptown Athens, directly across from the Athens County Courthouse.
      </p>
      <a class="btn btn--outline" href={mapsLink} target="_blank" rel="noopener">Open in Google Maps</a>
    </div>
  </section>
</Base>

<script define:vars={{ email: firm.email }}>
  const form = document.getElementById('contact-form');
  const error = form.querySelector('.error');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      error.hidden = false;
      return;
    }
    error.hidden = true;
    const d = new FormData(form);
    const subject = `Website inquiry from ${d.get('name')}`;
    const body = [
      `Name: ${d.get('name')}`,
      `Email: ${d.get('email')}`,
      d.get('phone') ? `Phone: ${d.get('phone')}` : null,
      '',
      d.get('message'),
    ]
      .filter((l) => l !== null)
      .join('\n');
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 4rem;
    align-items: start;
  }
  .info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem 2rem;
  }
  .h-small {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-dark);
    margin-bottom: 0.9rem;
  }
  address {
    font-style: normal;
    margin-bottom: 0.6rem;
  }
  .info a {
    font-weight: 500;
  }
  .kv {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    margin: 0;
    font-size: 0.95rem;
  }
  .kv dt {
    color: var(--muted);
  }
  .kv dd {
    margin: 0;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .note {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.8rem 0 0;
  }
  .pills {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .pills li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.25rem 0.85rem;
    font-size: 0.88rem;
  }

  .form-card {
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }
  .form-card h2 {
    font-size: 2rem;
    margin-bottom: 0.2rem;
  }
  .muted {
    color: var(--muted);
  }
  form {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.5rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  label > span {
    display: block;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }
  input:not([type='checkbox']),
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid #d6d2c8;
    border-radius: 8px;
    background: #fff;
    color: var(--text);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgb(168 130 63 / 0.18);
  }
  textarea {
    resize: vertical;
  }
  .consent {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
  }
  .consent input {
    margin-top: 0.3rem;
    accent-color: var(--accent);
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
  }
  .consent span {
    font-weight: 400;
    font-size: 0.86rem;
    color: var(--muted);
    margin: 0;
  }
  .error {
    margin: 0;
    color: #a12d2d;
    font-size: 0.9rem;
  }
  button {
    justify-self: start;
  }
  .fine {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
  }

  .map-section {
    position: relative;
    height: 480px;
    background: var(--bg-soft);
  }
  .map-section iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.35);
  }
  .map-card {
    position: absolute;
    left: max(1.25rem, calc((100vw - var(--container)) / 2 + 1.25rem));
    top: 50%;
    transform: translateY(-50%);
    max-width: 360px;
  }
  .map-card h2 {
    font-size: 1.9rem;
  }

  @media (max-width: 960px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .info,
    .row {
      grid-template-columns: 1fr;
    }
    .map-section {
      height: auto;
    }
    .map-section iframe {
      height: 320px;
    }
    .map-card {
      position: static;
      transform: none;
      max-width: none;
      margin: 1.25rem;
    }
  }
</style>
