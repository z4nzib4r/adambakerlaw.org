---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { url } from '../data/site';

const years = new Date().getFullYear() - 1988;

const credentials = [
  { year: '1983', title: 'B.A., International Relations', place: 'University of Illinois at Urbana-Champaign' },
  { year: '1987', title: 'Juris Doctor', place: 'Loyola University of Chicago School of Law' },
  {
    year: '1988',
    title: 'Admitted to the Illinois Bar',
    place: 'and the U.S. District Court for the Northern District of Illinois, Eastern Division',
  },
  {
    year: '1992',
    title: 'Admitted to the Ohio Bar',
    place: 'and the U.S. District Court for the Southern District of Ohio',
  },
];
---

<Base title="About" description="Attorney Adam J. Baker has provided competent legal assistance to clients in Athens, Ohio and the surrounding area for more than 36 years.">
  <PageHero
    eyebrow="About"
    title="Experience you can rely on."
    lead={`For more than ${years} years, Adam Baker has provided competent legal assistance to many satisfied clients in Athens, Ohio and the surrounding area.`}
  />

  <section class="section">
    <div class="container bio">
      <figure class="portrait">
        <img src={url('/images/about.png')} alt="Attorney Adam J. Baker" width="328" height="517" />
        <figcaption>
          <strong>Adam J. Baker</strong>
          Attorney &amp; Counselor at Law
        </figcaption>
      </figure>

      <div class="bio__body">
        <span class="eyebrow">My approach</span>
        <h2>Competent legal service, delivered with care.</h2>
        <p class="lead">
          I understand that when people hire an attorney, they are often experiencing very stressful situations.
          They need someone who is sensitive to them and their circumstances.
        </p>
        <p>
          I make sure my clients not only receive competent legal services, but also get the support and resources
          they deserve throughout the process.
        </p>

        <div class="card offers">
          <h3>What my practice offers</h3>
          <ul class="check-list">
            <li>{years}+ years of experience in various fields of law</li>
            <li>Reliable advice and representation by an experienced attorney</li>
            <li>Phone calls returned within one business day</li>
            <li>Honest assessments of cases, good and bad</li>
            <li>All work performed with care and attention to detail</li>
          </ul>
          <p class="offers__link"><a href={url('/practice-areas/')}>Explore practice areas →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Credentials</span>
        <h2>Education &amp; licenses</h2>
      </div>
      <ol class="timeline">
        {
          credentials.map((c) => (
            <li>
              <span class="timeline__year">{c.year}</span>
              <div>
                <h3>{c.title}</h3>
                <p>{c.place}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .bio {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 4.5rem;
    align-items: start;
  }
  .portrait {
    margin: 0;
    position: sticky;
    top: 130px;
  }
  .portrait img {
    border-radius: var(--radius);
    width: 100%;
    box-shadow: var(--shadow);
  }
  .portrait figcaption {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0.05em;
  }
  .portrait strong {
    font-family: var(--serif);
    font-size: 1.4rem;
    color: var(--ink);
    letter-spacing: 0;
  }
  .offers {
    margin-top: 2.5rem;
  }
  .offers h3 {
    margin-bottom: 1.2rem;
  }
  .offers__link {
    margin: 1.5rem 0 0;
    font-weight: 600;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .timeline li {
    background: #fff;
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.75rem;
  }
  .timeline__year {
    font-family: var(--serif);
    font-size: 2.1rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    display: block;
    margin-bottom: 1rem;
  }
  .timeline h3 {
    font-size: 1.3rem;
    margin-bottom: 0.4rem;
  }
  .timeline p {
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.55;
  }

  @media (max-width: 960px) {
    .timeline {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 820px) {
    .bio {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .portrait {
      position: static;
      max-width: 280px;
    }
  }
  @media (max-width: 520px) {
    .timeline {
      grid-template-columns: 1fr;
    }
  }
</style>
