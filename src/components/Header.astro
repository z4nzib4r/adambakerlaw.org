---
import { firm, nav, url } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const home = url("/");
const isActive = (href: string) => (href === home ? path === home : path.startsWith(href));
---

<header class="site-header">
  <div class="topbar">
    <div class="container topbar__inner">
      <span>{firm.address.street}, {firm.address.suite} · {firm.address.city}, {firm.address.state}</span>
      <span class="topbar__hours">Mon–Thu 9–5 · Fri by appointment</span>
    </div>
  </div>
  <div class="container bar">
    <a href={home} class="brand" aria-label={`${firm.name} — home`}>
      <span class="brand__mark" aria-hidden="true">AB</span>
      <span class="brand__text">
        <span class="brand__name">Adam Baker</span>
        <span class="brand__sub">Attorney &amp; Counselor at Law</span>
      </span>
    </a>

    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary nav__cta" href={firm.phoneHref}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
        {firm.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const header = document.querySelector('.site-header');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .topbar {
    background: var(--ink);
    color: rgb(255 255 255 / 0.78);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }
  .topbar__inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.45rem;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 76px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: var(--ink);
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand__name {
    font-family: var(--serif);
    font-size: 1.55rem;
    font-weight: 700;
  }
  .brand__sub {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .nav ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    position: relative;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
    padding-block: 0.4rem;
  }
  .nav ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.2s;
  }
  .nav ul a:hover::after,
  .nav ul a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav ul a[aria-current='page'] {
    color: var(--ink);
  }
  .nav__cta {
    padding: 0.65rem 1.15rem;
    font-size: 0.9rem;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
    position: relative;
  }
  .menu-toggle__bars,
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    position: absolute;
    left: 11px;
    width: 20px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s, opacity 0.2s;
  }
  .menu-toggle__bars {
    top: 21px;
  }
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    content: '';
    left: 0;
  }
  .menu-toggle__bars::before {
    top: -6px;
  }
  .menu-toggle__bars::after {
    top: 6px;
  }
  .is-open .menu-toggle__bars {
    background: transparent;
  }
  .is-open .menu-toggle__bars::before {
    transform: translateY(6px) rotate(45deg);
  }
  .is-open .menu-toggle__bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 960px) {
    .topbar__hours {
      display: none;
    }
    .menu-toggle {
      display: block;
    }
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1rem 1.25rem 1.5rem;
      background: #fff;
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .is-open .nav {
      display: flex;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav ul a {
      display: block;
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--line);
    }
    .nav ul a::after {
      display: none;
    }
    .nav__cta {
      justify-content: center;
    }
  }

  @media (max-width: 420px) {
    .brand__sub {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
    }
    .topbar {
      display: none;
    }
  }
</style>
