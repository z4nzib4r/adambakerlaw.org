---
import { firm, url } from '../data/site';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Have a question about your situation?',
  text = 'Call the office or send a message. Phone calls are returned within one business day.',
} = Astro.props;
---

<section class="cta-band">
  <div class="container inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn btn--primary" href={firm.phoneHref}>Call {firm.phone}</a>
      <a class="btn btn--ghost" href={url("/contact-me/")}>Send a message</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--ink-2);
    color: rgb(255 255 255 / 0.8);
    padding-block: 3.5rem;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  h2 {
    color: #fff;
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    margin-bottom: 0.3rem;
  }
  p {
    margin: 0;
  }
  .actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>
